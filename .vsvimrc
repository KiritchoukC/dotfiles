" use local vimrc if exist
"set exrc
" show numbers in margin
set nu
" show numbers relative to the current line
" set relativenumber
" do not highlight search results
set nohlsearch
" do not hide inactive buffers
"set hidden
" do not beep for error messages
"set noerrorbells
" use 4 spaces for tabs
set tabstop=4 softtabstop=4 shiftwidth=4
" use indent in insert mode
set expandtab
" copy indent from current line when starting a new line
set autoindent
" autoindent on new line
"set smartindent
" prevent lines to wrap when reaching the edge of the window
set nowrap
" prevent from generating a .swp file
"set noswapfile
" prevent from generating a backup file on overwrite
"set nobackup
" where to keep the undo history
"set undodir=~/.vim/undodir
" use file for undo history
"set undofile
" show results during the search
set incsearch
" enable term colors
"set termguicolors
" keep an offset when scrolling
set scrolloff=5
"set scrolloff=8 sidescrolloff=5
" show the current mode on the last line
"set noshowmode
" set a ruler at column 90
"set colorcolumn=90
" always show sign column
"set signcolumn=yes
" use 2 lines for the command line
"set cmdheight=2
" Always show status line
set laststatus=2
" enables command-line completion
"set wildmenu
" reload buffer when file is changed outside of vim
"set autoread
" command line history
if &history < 1000
  set history=1000
endif
" maximum number of tab pages to be opened by the |-p| command line
if &tabpagemax < 50
  set tabpagemax=50
endif

"set encoding=utf-8

nnoremap s <Nop>
" show info popup where cursor is
nnoremap gh :vsc Edit.QuickInfo<CR>

vnoremap <C-e> :vsc Edit.MoveSelectedLinesDown<CR>
vnoremap <C-i> :vsc Edit.MoveSelectedLinesUp<CR>
nnoremap gr :vsc Edit.FindAllReferences<CR>
nnoremap <leader>gd :vsc Edit.GoToImplementation<CR><Esc>
" start horizontal split
nnoremap <leader>hs :split<CR><C-k>ZZ<C-l> 

"------------------------
" WINDOWS MANAGEMENT
"------------------------
" Close all documents
nnoremap ZA :wa<CR> :vsc Window.CloseAllDocuments<CR> 
" Close all documents except the pinned ones
nnoremap ZP :wa<CR> :vsc Window.CloseAllButPinned<CR> 
" Close all documents except the current one
nnoremap ZT :wa<CR> :vsc File.CloseAllButThis<CR> 
" Keep temporary tab opened
nnoremap <leader>gh :vsc Window.KeepTabOpen<CR> 
" Pin current document
nnoremap <leader>gp :vsc Window.PinTab<CR> 
" Move current document to next group of tabs (useful when in split mode)
nnoremap <leader>wO :vsc Window.MoveToNextTabGroup<CR> 
" Move current document to previous group of tabs (useful when in split mode)
nnoremap <leader>wN :vsc Window.MoveToPreviousTabGroup<CR> 
" Make the current tab a floating window
nnoremap <leader>wf :vsc Window.Float<CR> 
" Make the current floating window a tab
nnoremap <leader>wF :vsc Window.MoveToMainDocumentGroup<CR> 

" tests
nnoremap <leader>te :vsc TestExplorer.ShowTestExplorer<CR> 
" Run test under cursor
nnoremap <leader>tt :vsc TestExplorer.RunAllTestsInContext<CR> 
" Run test under cursor in debug mode
nnoremap <leader>td :vsc TestExplorer.DebugAllTestsInContext<CR> 
"Run all tests
nnoremap <leader>ta :vsc TestExplorer.RunAllTests<CR> 

" navigation
" Go to next error
vnoremap <leader>ne :vsc View.NextError<CR> 
" Go to next error
nnoremap <leader>ne :vsc View.NextError<CR> 
"Go to next find
vnoremap <leader>nf :vsc Edit.GoToNextLocation<CR> 
"Go to next find
nnoremap <leader>nf :vsc Edit.GoToNextLocation<CR> 
"Go to previous find
vnoremap <leader>pf :vsc Edit.GoToPrevLocation<CR> 
"Go to previous find
nnoremap <leader>pf :vsc Edit.GoToPrevLocation<CR> 
"Go to next reference
vnoremap <leader>nr :vsc Edit.NextHighlightedReference<CR> 
"Go to next reference
nnoremap <leader>nr :vsc Edit.NextHighlightedReference<CR> 
"Go to previous reference
vnoremap <leader>pr :vsc Edit.PreviousHighlightedReference<CR> 
"Go to previous reference
nnoremap <leader>pr :vsc Edit.PreviousHighlightedReference<CR> 
" Go back
nnoremap <C-t> :vsc View.NavigateBackward<CR>
" Go forward
nnoremap <C-T> :vsc View.NavigateForward<CR>

" views
" Open Error view
nnoremap <leader>ve :vsc View.ErrorList<CR> 
" Open Output view
nnoremap <leader>vo :vsc View.Output<CR> 
" Open Tfs view
nnoremap <leader>vc :vsc View.TfsPendingChanges<CR> 
" Open References view
nnoremap <leader>vr :vsc View.FindReferencesWindow1<CR> 
" Open Find view
nnoremap <leader>vf :vsc View.FindResultsWindow1<CR> 
" Open Application Insights View
nnoremap <leader>va :vsc View.ApplicationInsightsSearch<CR> 
" Open Test view
nnoremap <leader>vt :vsc TestExplorer.ShowTestExplorer<CR> 

" code edition
nnoremap <leader>rr :vsc Refactor.Rename<CR><ESC>i
nnoremap <leader>ro :vsc Refactor.ReorderParameters<CR>
nnoremap <leader>bb :vsc EditorContextMenus.CodeWindow.Breakpoint.InsertBreakpoint<CR>
" use with AceJump extension to enable smarter jump
nnoremap <leader>sa :vsc Tools.InvokeAceJumpCommand<CR> 
" use with Code alignment extension
nnoremap <leader>z= :vsc Edit.AlignByEquals<CR> 
" use with Code alignment extension
nnoremap <leader>z, :vsc Edit.AlignByString<CR> 
" sort usings
nnoremap <leader>zzu :vsc Edit.RemoveAndSort<CR> 

" comment/uncomment selected lines
vnoremap gc :vsc Edit.ToggleLineComment<CR> 
" comment/uncomment current line
nnoremap gcc :vsc Edit.ToggleLineComment<CR> 

" open Nuget Package Manager for the current project
nnoremap <leader>nu :vsc Project.ManageNugetPackages<CR> 
" open Nuget Package Manager for the whole solution
nnoremap <leader>ns :vsc Tools.ManageNugetPackagesforSolution<CR> 
nnoremap <leader>6 :vsc Build.BuildSolution<CR>


"------------------------
" SURROUND
"------------------------

" Surround simulating bindings
nnoremap s( ciw(<C-r>")<Esc>
nnoremap s[ ciw[<C-r>"]<Esc>
nnoremap s{ ciw{<C-r>"}<Esc>
nnoremap s< ciw<lt><C-r>"><Esc>
nnoremap s" ciw"<C-r>""<Esc>
nnoremap s' ciw'<C-r>"'<Esc>
nnoremap sw( ciW(<C-r>")<Esc>
nnoremap sw[ ciW[<C-r>"]<Esc>
nnoremap sw{ ciW{<C-r>"}<Esc>
nnoremap sw< ciW<lt><C-r>"><Esc>
nnoremap sw" ciW"<C-r>""<Esc>
nnoremap sw' ciW'<C-r>"'<Esc>

" Surround delete bindings
nnoremap ds( vi(dvhp
nnoremap ds[ vi[dvhp
nnoremap ds{ vi{dvhp
nnoremap ds< vi<dvhp
nnoremap ds" vi"dvhp
nnoremap ds' vi'dvhp

" Surround change bindings
nnoremap cs"' vi"oh<Esc>msvi"l<Esc>cl'<Esc>`scl'<Esc>
nnoremap cs'" vi'oh<Esc>msvi'l<Esc>cl"<Esc>`scl"<Esc>

" Surround visual selected text
vnoremap S" c"<C-r>""<Esc>
vnoremap S' c"<C-r>"'<Esc>
vnoremap S( c(<C-r>")<Esc>
vnoremap S[ c[<C-r>"]<Esc>
vnoremap S{ c{<C-r>"}<Esc>
vnoremap S< c<lt><C-r>"><Esc>
vnoremap S* c/*<C-r>"*/<Esc>
"vnoremap St c<lt>div><CR><C-r>"<Esc>
" Surround in div tag and edit tag
vnoremap St c<lt>div><CR><C-r>"<Esc>`<lt>lcw

" add field to constructor for dependency injection
nnoremap <leader>zi $hvbb"zy/)<CR>kA,<CR><ESC>cc<ESC>"zpbx"xyiw>>>>>>/}<CR>O_<ESC>"xpa<space>=<space><ESC>"xpA;<ESC><C-O><C-O>$
" Add interface
nnoremap <leader>zI _ww"zyiwA,<space>I<esc>"zp
" make string an interpolated string by adding $ at the beginning
nnoremap <leader>zs ?"<CR>i$<ESC>``l

" select outer method
nnoremap vaa ?public\|protected\|private\|function<CR>{jVN/{<CR>%
" select inner method
nnoremap vai ?public\|protected\|private\|function<CR>/{<CR>jVk%k 
" yank outer method
nnoremap yaf ?public\|protected\|private\|function<CR>{jVN/{<CR>%y
" yank outer method and paste below
nnoremap yafp ?public\|protected\|private\|function<CR>{jVN/{<CR>%yn%o<ESC>p
" cut outer method
nnoremap daf ?public\|protected\|private\|function<CR>{VN/{<CR>%d
" yank inner method
nnoremap yif ?public\|protected\|private\|function<CR>/{<CR>jyiB
" cut inner method
nnoremap dif ?public\|protected\|private\|function<CR>/{<CR>jdiB

" find next method
nnoremap <leader>nm /public\|protected\|private\|function<CR>f(b
" find previous method
nnoremap <leader>pm ?public\|protected\|private\|function<CR>f(b

" remove bracket encapsulation
nnoremap <leader>di viB<diBpkVkkd
" remove try catch encapsulation
nnoremap <leader>dt ?try<CR>dd<iBdiBkP/catch<CR>kk3dddaBdd

" change inner next parentheses
nnoremap cinb /(<CR>cib
" delete inner next parentheses
nnoremap dinb /(<CR>dib

let mapleader = " "

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" General mappings
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Sane redo.
noremap U <C-r>
" +/- increment and decrement.
" move line down
vnoremap <C-e> :m '>+1<CR>gv=gv
" move line up
vnoremap <C-i> :m '>-2<CR>gv=gv
" join lines
nnoremap <leader>j J
vnoremap <leader>j J
" get help for the command under the caret
nnoremap <leader>k K
vnoremap <leader>k K
" reload .vimrc
nnoremap <leader>x :so $MYVIMRC<CR>
" save buffer
nnoremap <leader>ww :wa<CR>
" return to line before the caret
nnoremap <leader>i i<CR><ESC>
" return to line after the caret
nnoremap <leader>a a<CR><ESC>
" insert a blank line below
nnoremap <leader>l o<ESC>
" insert a blank line above
nnoremap <leader>L O<ESC>
" rename word under the caret and replace the occurences with '.'
nnoremap <leader>r *Ncgn
" rename word selected replace the occurences with '.'
vnoremap <leader>r "zy:let @/='\V'.escape(@z, '/\')<CR>cgn
" close all the buffers but the current one
nnoremap <leader>to :tabonly<CR>
" format the whole buffer
nnoremap <leader>= gg=G<C-o>
" vertical split
nnoremap <leader>vs :vs<CR>
" horizontal split
nnoremap <leader>hs :split<CR>
" yank whole buffer
nnoremap Y ggyG

"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" System clipboard
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" yank to system cb
nnoremap <leader>y "+y
vnoremap <leader>y "+y
" cut to system cb
nnoremap <leader>d "+d
vnoremap <leader>d "+d
" past from system cb after caret
nnoremap <leader>p "+p
vnoremap <leader>p "+p
" past from system cb before caret
nnoremap <leader>P "+P
vnoremap <leader>P "+P
" yank the whole buffer to system cb
nnoremap <leader>Y gg"+yG
" cut the whole buffer to system cb
nnoremap <leader>D gg"+dG

" leader shortcuts
nnoremap <leader>,, f,a<CR><ESC>
nnoremap <leader>.. f.i<CR><ESC>
nnoremap <leader>A ddO
nnoremap <leader><leader>piw viwpyiw
nnoremap <leader><leader>pp Vpyy

" --- COLEMAK ---
inoremap ao <ESC>
inoremap a; <ESC>A;<ESC>

